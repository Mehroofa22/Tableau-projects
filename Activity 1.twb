      <aliases enabled='yes' />
      <column caption='Days to Ship' datatype='integer' name='[Calculation_1758437530292224]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Order Date], [Ship Date])' />
      </column>
      <column caption='order processing speed' datatype='string' name='[Calculation_1758437531734017]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1758437530292224] = 0 THEN&#13;&#10;    &quot;Same Day&quot;&#13;&#10;ELSEIF [Calculation_1758437530292224] &lt;= 2 THEN&#13;&#10;    &quot;Fast&quot;&#13;&#10;ELSEIF [Calculation_1758437530292224] &lt;= 5 THEN&#13;&#10;    &quot;Normal&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Delayed&quot;&#13;&#10;END' />
      </column>
      <column caption='First word of product' datatype='string' name='[Calculation_1758437533454338]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='SPLIT([Product Name], &quot; &quot;, 1)' />
      </column>
      <column caption='numeric postal code' datatype='string' name='[Calculation_1758437533712387]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='REGEXP_REPLACE(STR([Postal Code]), &quot;[^0-9]&quot;, &quot;&quot;)' />
      </column>
      <column caption='Customer total sales' datatype='integer' name='[Calculation_1758437533933572]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Customer Name] : SUM([Sales]) }' />
      </column>
      <column caption='customer category' datatype='string' name='[Calculation_1758437534048261]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1758437533933572] &gt;= 5000 THEN&#13;&#10;    &quot;High Value&quot;&#13;&#10;ELSEIF [Calculation_1758437533933572] &gt;= 2000 THEN&#13;&#10;    &quot;Medium Value&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Low Value&quot;&#13;&#10;END' />
      </column>
      <column datatype='string' name='[Postal Code]' role='dimension' semantic-role='[ZipCode].[Name]' type='nominal' />
      <column caption='Superstore Activity Data' datatype='table' name='[__tableau_internal_object_id__].[Superstore Activity Data_2106AB5F90474EAB8BFFA043F5340311]' role='measure' type='quantitative' />
      <layout dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
